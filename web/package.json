{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/sync-data.mjs --mode=dev && vite",
    "build": "node scripts/sync-data.mjs --mode=build && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "sync-data": "node scripts/sync-data.mjs --mode=dev",
    "perf": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config playwright.perf.config.ts",
    "perf:idle": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config playwright.perf.config.ts e2e-perf/idle.spec.ts",
    "perf:traffic": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config playwright.perf.config.ts e2e-perf/traffic.spec.ts",
    "perf:video": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config playwright.perf.config.ts e2e-perf/video.spec.ts",
    "gate": "GATE=1 PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=real e2e/gate.spec.ts",
    "speed-shots": "SPEED_SHOTS=1 PLAYWRIGHT_BROWSERS_PATH=0 playwright test --project=real e2e/speed.spec.ts",
    "gate-video": "GATE=1 PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config playwright.perf.config.ts e2e-perf/gate-video.spec.ts",
    "trips-fixture": "node scripts/make-trips-fixture.mjs",
    "stress-trips": "node scripts/make-stress-trips.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "~9.4.0",
    "@deck.gl/geo-layers": "~9.4.0",
    "@deck.gl/layers": "~9.4.0",
    "@deck.gl/mapbox": "~9.4.0",
    "@luma.gl/core": "~9.4.2",
    "@luma.gl/engine": "~9.4.2",
    "@luma.gl/shadertools": "~9.4.2",
    "@math.gl/web-mercator": "^4.1.0",
    "hyparquet": "~1.31.5",
    "maplibre-gl": "5.24.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "~8.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@maplibre/maplibre-gl-style-spec": "~24.10.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
